font_family      family="JetBrainsMono Nerd Font Mono"
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size 11


# -- color scheme --
background_opacity 0.5
background_blur 0

# -- misc settings --
enable_audio_bell   no
force_ltr           no
detect_urls         yes

disable_ligatures     no
url_style             curly
remember_window_size  no
shell_integration disabled

scrollbar_handle_opacity        0
scrollbar_track_opacity         0
scrollbar_track_hover_opacity   0

confirm_os_window_close         0

hide_window_decorations no

# Top and bottom padding removing to make it look more like a terminal and less like a floating window
window_padding_width 0
placement_strategy top-left
resize_in_steps no

modify_font cell_height 92%
modify_font baseline -1


allow_remote_control yes

# Performance
repaint_delay 8
input_delay 3

#literally v-sync off
sync_to_monitor no
